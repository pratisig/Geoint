# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---------------------------------------------------------------------------
# Persistence (v4.2)
# ---------------------------------------------------------------------------
# Point this at a PostgreSQL instance to keep the event archive across
# restarts. Render's free web service has an EPHEMERAL filesystem and cannot
# attach a persistent disk, so a local SQLite file is wiped on every spin-down
# and every redeploy — this variable is what makes HISTORY durable in
# production. Leave it empty to stay on SQLite (fine locally).
#
# storage.py switches backends on its own; no code change is needed. If the
# database is unreachable the app still boots and downgrades to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/osint

# Where the SQLite file lives when DATABASE_URL is not set.
# OSINT_DB_PATH=osint_database.db

# How many days archived events are kept before DELETE /api/history/prune
# removes them.
# OSINT_RETENTION_DAYS=365

# Set to 1 to make an unreachable PostgreSQL an error instead of a silent
# downgrade. Used by the integration tests.
# OSINT_DB_STRICT=1
